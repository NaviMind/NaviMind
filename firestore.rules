rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔧 Утилиты
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function willBeOwner() {
      return isSignedIn() && request.resource.data.ownerId == uid();
    }
    function isOwner(ownerId) {
      return isSignedIn() && ownerId == uid();
    }

    // 💳 Billing integrity: a client can't raise its own plan to a paid tier or
    //    inflate topUpTokens. Only the server (Admin SDK / Paddle webhook)
    //    bypasses these rules.
    function planOf(d)  { return ('plan' in d) ? d.plan : 'free'; }
    function topUpOf(d) { return ('topUpTokens' in d) ? d.topUpTokens : 0; }
    function planClientOk(nw, old) {
      return !('plan' in nw) || planOf(nw) == planOf(old) || nw.plan == 'free';
    }
    function topUpClientOk(nw, old) {
      return topUpOf(nw) <= topUpOf(old);
    }

    // 🔐 1) Профиль пользователя (с защитой биллинга)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
                    && topUpOf(request.resource.data) == 0;
      allow update: if isOwner(userId)
                    && planClientOk(request.resource.data, resource.data)
                    && topUpClientOk(request.resource.data, resource.data);
      allow delete: if isOwner(userId);
    }

    // ✅ Универсально открыть ВСЕ подколлекции внутри /users/{uid}
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // 📁 2) Фиксированные шаблоны (например, IMPA, Checklists)
    match /templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 🗂 3) My Topics (папки, ярлыки и т.п.)
    match /topics/{topicId} {
      allow create: if willBeOwner();
      allow read, update, delete: if isOwner(resource.data.ownerId);
    }

    // 💬 4) Общие (глобальные) чаты: /chats/{chatId}
    match /chats/{chatId} {
      allow create: if willBeOwner();
      allow read, update, delete: if isOwner(resource.data.ownerId);

      match /messages/{msgId} {
        allow create, read, update, delete: if isOwner(
          get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId
        );
      }
    }

    // 👤 5) Личные чаты юзера: /users/{uid}/chats/{chatId}
    match /users/{userId}/chats/{chatId} {
      allow create, read, update, delete: if isOwner(userId);

      match /messages/{msgId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    // 🗂 5.1) Топики пользователя: /users/{uid}/topics/{topicId}
    match /users/{userId}/topics/{topicId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    // 💬 5.2) Чаты внутри топика: /users/{uid}/topics/{topicId}/chats/{chatId}
    match /users/{userId}/topics/{topicId}/chats/{chatId} {
      allow create, read, update, delete: if isOwner(userId);

      match /messages/{msgId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    // 🧩 6) Проектные чаты: /users/{uid}/projectChats/{templateId}/{chatId}
    match /users/{userId}/projectChats/{templateId}/{chatId} {
      allow create, read, update, delete: if isOwner(userId);

      match /messages/{msgId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    // 🚫 7) Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
