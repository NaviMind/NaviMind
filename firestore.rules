rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User scope ───────────────────────────────────────────────────────────
    // Every document under users/{userId} — including the profile doc itself
    // and ALL sub-collections (chats, topics, libraryFiles, drawings,
    // drawingFolders, …) — is readable and writable only by that user.
    //
    // The recursive wildcard {document=**} covers every depth, so we don't
    // need to enumerate each sub-collection. Adding a new collection in code
    // does NOT require a rules change.

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else that isn't nested under a user document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
